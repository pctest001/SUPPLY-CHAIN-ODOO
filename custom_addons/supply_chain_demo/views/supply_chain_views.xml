            <xpath expr="//search" position="attributes">
                <attribute name="string">搜索采购订单</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">订单</attribute>
            </xpath>
            <xpath expr="//filter[@name='my_Orders']" position="attributes">
                <attribute name="string">我的订单</attribute>
            </xpath>
            <xpath expr="//filter[@name='starred']" position="attributes">
                <attribute name="string">星标</attribute>
            </xpath>
            <xpath expr="//filter[@name='not_invoiced']" position="attributes">
                <attribute name="string">待开票</attribute>
            </xpath>
            <xpath expr="//filter[@name='invoiced']" position="attributes">
                <attribute name="string">已收账单</attribute>
            </xpath>
            <xpath expr="//filter[@name='order_date']" position="attributes">
                <attribute name="string">订单日期</attribute>
            </xpath>
            <xpath expr="//filter[@name='activities_exception']" position="attributes">
                <attribute name="string">警告</attribute>
            </xpath>
            <xpath expr="//group" position="attributes">
                <attribute name="string">分组</attribute>
            </xpath>
            <xpath expr="//filter[@name='vendor']" position="attributes">
                <attribute name="string">供应商</attribute>
            </xpath>
            <xpath expr="//filter[@name='representative']" position="attributes">
                <attribute name="string">采购员</attribute>
            </xpath>
        </field>
    </record>

    <!-- 独立采购订单明细行列表 中文化 -->
    <record id="view_purchase_order_line_tree_sc_zh" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.sc.zh</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="string">采购订单明细</attribute>
            </xpath>
            <xpath expr="//field[@name='order_id']" position="attributes">
                <attribute name="string">采购订单</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">描述</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">供应商</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="string">产品</attribute>
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="string">单价</attribute>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="attributes">
                <attribute name="string">数量</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom']" position="attributes">
                <attribute name="string">单位</attribute>
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="attributes">
                <attribute name="string">金额</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="string">计划日期</attribute>
            </xpath>
        </field>
    </record>

    <!-- 独立采购订单明细行搜索 中文化 -->
    <record id="view_purchase_order_line_search_sc_zh" model="ir.ui.view">
        <field name="name">purchase.order.line.search.sc.zh</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="attributes">
                <attribute name="string">搜索采购订单明细</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">供应商</attribute>
            </xpath>
            <xpath expr="//filter[@name='groupby_supplier']" position="attributes">
                <attribute name="string">供应商</attribute>
            </xpath>
        </field>
    </record>

    <!-- 采购看板（仪表盘列表变体）按钮 中文化 -->
    <record id="view_purchase_order_kpis_tree_sc_zh" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.sc.zh</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_create_invoice']" position="attributes">
                <attribute name="string">创建账单</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_cancel']" position="attributes">
                <attribute name="string">取消</attribute>
            </xpath>
        </field>
