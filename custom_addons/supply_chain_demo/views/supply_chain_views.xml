    <!-- ============ B3 配方主数据 ============ -->
    <record id="action_sc_recipe" model="ir.actions.act_window">
        <field name="name">配方</field>
        <field name="res_model">sc.recipe</field>
        <field name="view_mode">list,form</field>
        <field name="help">维护流程制造成品的配方（原料配比）。</field>
    </record>

    <menuitem id="menu_sc_master_root" name="主数据" parent="menu_supply_chain_root" sequence="15"/>
    <menuitem id="menu_sc_recipe" name="配方（BOM）" parent="menu_sc_master_root"
              action="action_sc_recipe" sequence="10"/>

    <record id="view_sc_recipe_list" model="ir.ui.view">
        <field name="name">sc.recipe.list</field>
        <field name="model">sc.recipe</field>
        <field name="arch" type="xml">
            <list string="配方" decoration-info="line_count == 0">
                <field name="code"/>
                <field name="name"/>
                <field name="finished_product_tmpl_id"/>
                <field name="company_id"/>
                <field name="total_qty"/>
                <field name="line_count" string="原料数" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sc_recipe_form" model="ir.ui.view">
        <field name="name">sc.recipe.form</field>
        <field name="model">sc.recipe</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="code" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="finished_product_tmpl_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="uom_id"/>
                            <field name="total_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="原料明细">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="percentage" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="工艺备注">
                            <field name="note" nolabel="1" placeholder="如投料顺序、温度、混合时间等"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 成品物料表单：展示其配方 -->
    <record id="view_product_template_form_sc_recipe" model="ir.ui.view">
        <field name="name">product.template.form.sc.recipe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="配方" invisible="not is_process_mfg">
                    <field name="recipe_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="total_qty"/>
                            <button name="action_open_form" type="object" string="查看"
                                    class="btn-secondary" icon="fa-external-link"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============ E1 供应商协同（交期确认） ============ -->
    <record id="action_sc_supplier_ack" model="ir.actions.act_window">
        <field name="name">交期确认</field>
        <field name="res_model">sc.supplier.ack</field>
        <field name="view_mode">list,form</field>
        <field name="help">供应商交期确认工作台：跟踪各 PO 的供应商交期确认情况。</field>
    </record>

    <menuitem id="menu_sc_supplier_root" name="供应商协同" parent="menu_supply_chain_root" sequence="25"/>
    <menuitem id="menu_sc_supplier_ack" name="交期确认" parent="menu_sc_supplier_root"
              action="action_sc_supplier_ack" sequence="10"/>

    <record id="view_sc_supplier_ack_list" model="ir.ui.view">
        <field name="name">sc.supplier.ack.list</field>
        <field name="model">sc.supplier.ack</field>
        <field name="arch" type="xml">
            <list string="供应商交期确认" decoration-warning="state=='pending'"
                  decoration-success="state=='confirmed'" decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="po_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="committed_date"/>
            </list>
        </field>
    </record>

    <record id="view_sc_supplier_ack_form" model="ir.ui.view">
        <field name="name">sc.supplier.ack.form</field>
        <field name="model">sc.supplier.ack</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,confirmed,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="po_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="committed_date"/>
                            <field name="confirmed_at" readonly="1"/>
                            <field name="confirmed_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="remark" nolabel="1" placeholder="供应商备注 / 交期说明"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 采购订单：供应商协同入口与状态展示 -->
    <record id="view_purchase_order_form_sc_supplier_ack" model="ir.ui.view">
        <field name="name">purchase.order.form.sc.supplier.ack</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_register_supplier_ack" string="登记供应商交期" type="object"
                        class="btn-secondary" icon="fa-handshake-o"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="供应商协同" colspan="2">
                    <field name="supplier_ack_state"/>
                    <field name="supplier_committed_date"/>
                    <button name="action_register_supplier_ack" string="登记/更新交期确认" type="object"
                            class="btn-secondary" invisible="supplier_ack_state == 'confirmed'"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 供应商交期确认 向导 -->
    <record id="view_sc_supplier_ack_wizard_form" model="ir.ui.view">
        <field name="name">sc.supplier.ack.wizard.form</field>
        <field name="model">sc.supplier.ack.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="po_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="committed_date"/>
                    <field name="remark"/>
                </group>
                <footer>
                    <button name="action_confirm" string="确认交期" type="object" class="btn-primary"/>
                    <button name="action_reject" string="驳回" type="object" class="btn-secondary"/>
                    <button string="关闭" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
