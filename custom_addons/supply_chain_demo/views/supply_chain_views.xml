    <!-- ============ C3 收货：批次/效期 中文化 ============ -->
    <!-- 收货明细（Detailed Operations）表格：批次号 + 效期 中文化 -->
    <record id="view_stock_move_line_detailed_op_sc_zh" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.op.sc.zh</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="product_expiry.view_stock_move_line_detailed_operation_tree_expiry"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="string">批次号</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="string">效期</attribute>
            </xpath>
        </field>
