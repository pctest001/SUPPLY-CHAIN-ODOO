    <!-- 批次(Lot) 表单：批次号 + 效期 中文化 -->
    <record id="view_production_lot_form_sc_zh" model="ir.ui.view">
        <field name="name">stock.production.lot.form.sc.zh</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="string">效期</attribute>
            </xpath>
            <xpath expr="//field[@name='removal_date']" position="attributes">
                <attribute name="string">移除日期</attribute>
            </xpath>
